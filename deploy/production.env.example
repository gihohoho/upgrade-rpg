# Review-only production variable inventory. Do not copy this file to a real
# production host without replacing every angle-bracket placeholder through an
# approved secret/deployment platform.

POSTGRES_IMAGE=postgres:16-alpine@sha256:<approved-64-hex-digest>
POSTGRES_DB=rpg_game
POSTGRES_USER=rpg_user
POSTGRES_PASSWORD_FILE=<absolute-host-path-to-postgres-password-secret>
POSTGRES_CA_FILE=<absolute-host-path-to-approved-postgres-ca.pem>

# asyncpg accepts PostgreSQL URI SSL parameters. Production review requires
# certificate and hostname verification rather than sslmode=require.
DATABASE_URL=postgresql+asyncpg://rpg_user:<url-encoded-password>@<tls-postgres-host>:5432/rpg_game?sslmode=verify-full&sslrootcert=/run/secrets/postgres_ca.pem

APP_NAME=Idle RPG Backend
JWT_SECRET_KEY=<generate-a-random-secret-of-at-least-32-characters>
ADMIN_WRITE_DEV_KEY=<generate-a-different-random-secret-of-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://<approved-game-origin>"]

DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
