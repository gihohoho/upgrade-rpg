# Review-only production variable inventory for the v334 reviewed deployment plan.
# BACKEND_IMAGE is the verified immutable candidate. Do not copy this file to a real
# production host until every remaining angle-bracket placeholder is replaced through
# an approved secret/deployment platform.

BACKEND_IMAGE=ghcr.io/gihohoho/upgrade-rpg-backend@sha256:f3bf6eed45e46e9d2022df4ab62eb6ca55b1ec0997b8ed342ae250c4a60052c1
EDGE_NETWORK_NAME=<pre-created-reverse-proxy-network-name>
POSTGRES_CA_FILE=<absolute-host-path-to-approved-managed-postgres-ca.pem>

# asyncpg production review requires certificate and hostname verification.
# The actual user/password/host must come from the selected managed provider.
DATABASE_URL=postgresql+asyncpg://<managed-db-user>:<url-encoded-password>@<managed-db-host>:5432/rpg_game?sslmode=verify-full&sslrootcert=/run/secrets/postgres_ca.pem

APP_NAME=Idle RPG Backend
JWT_SECRET_KEY=<generate-a-random-secret-of-at-least-32-characters>
ADMIN_WRITE_DEV_KEY=<generate-a-different-random-secret-of-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://<approved-game-origin>"]

EMAIL_PROVIDER=brevo
BREVO_API_KEY=<project-specific-brevo-api-key>
BREVO_FROM_EMAIL=<verified-brevo-sender-email>
BREVO_FROM_NAME=Upgrade RPG
EMAIL_TOKEN_SECRET=<generate-a-separate-random-secret-of-at-least-32-characters>
AUTH_ABUSE_SECRET=<generate-another-separate-random-secret-of-at-least-32-characters>
PUBLIC_FRONTEND_ORIGIN=https://<approved-game-origin>
EMAIL_DELIVERY_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_SECONDS=1
EMAIL_OUTBOX_MAINTENANCE_INTERVAL_SECONDS=300
EMAIL_OUTBOX_PREPARING_TIMEOUT_SECONDS=300
EMAIL_OUTBOX_SENDING_TIMEOUT_SECONDS=120
EMAIL_OUTBOX_RETENTION_DAYS=30

REQUEST_BODY_LIMIT_BYTES=2100000
AUTH_REQUEST_BODY_LIMIT_BYTES=16384
AUTH_TRUSTED_PROXY_MODE=render
AUTH_DISCOVERY_RESPONSE_FLOOR_MS=350
AUTH_DISCOVERY_RESPONSE_JITTER_MS=100
AUTH_RATE_LIMIT_RETENTION_DAYS=30
UNVERIFIED_ACCOUNT_TTL_HOURS=168

DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
