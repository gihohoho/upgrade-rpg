# Review-only production variable inventory for the v312 selected architecture.
# Do not copy this file to a real production host without replacing every
# angle-bracket placeholder through an approved secret/deployment platform.

BACKEND_IMAGE=<approved-registry>/upgrade-rpg-backend@sha256:<approved-64-hex-digest>
EDGE_NETWORK_NAME=<pre-created-reverse-proxy-network-name>
POSTGRES_CA_FILE=<absolute-host-path-to-approved-managed-postgres-ca.pem>

# asyncpg production review requires certificate and hostname verification.
# The actual user/password/host must come from the selected managed provider.
DATABASE_URL=postgresql+asyncpg://<managed-db-user>:<url-encoded-password>@<managed-db-host>:5432/rpg_game?sslmode=verify-full&sslrootcert=/run/secrets/postgres_ca.pem

APP_NAME=Idle RPG Backend
JWT_SECRET_KEY=<generate-a-random-secret-of-at-least-32-characters>
ADMIN_WRITE_DEV_KEY=<generate-a-different-random-secret-of-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://<approved-game-origin>"]

DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
