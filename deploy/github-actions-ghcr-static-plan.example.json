      "pythonRuntimeImageDigestPinned": true,
      "pythonBuildSystemRequirementsHashLocked": false,
      "pythonApplicationDependenciesHashLocked": false,
      "pipUpgradePinned": false,
      "dockerfileFrontendDigestPinned": false,
