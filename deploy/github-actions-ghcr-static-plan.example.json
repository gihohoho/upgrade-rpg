  "supplyChainGates": {
    "failurePolicy": "fail-closed",
    "prePushOrder": [
      "repository-static-checks",
      "build-local-oci-linux-amd64",
      "generate-spdx-json-sbom",
      "validate-sbom-subject",
      "scan-high-critical-vulnerabilities"
    ],
    "vulnerabilityGate": {
      "scanner": "trivy",
      "severity": [
        "HIGH",
        "CRITICAL"
      ],
      "exitCodeOnFinding": 1,
      "ignoreUnfixed": false,
      "allowIgnoreFile": false,
      "allowInlineExceptions": false
    },
    "postPushOrder": [
      "capture-exact-registry-digest",
      "attest-build-provenance",
      "attest-spdx-sbom",
      "cosign-keyless-sign-digest",
      "verify-provenance-and-sbom-attestations",
      "verify-cosign-identity-and-issuer",
      "emit-reviewed-candidate-digest"
    ],
    "attestationVerification": {
      "subjectMustEqualPushedDigest": true,
      "repository": "gihohoho/upgrade-rpg",
      "signerWorkflow": ".github/workflows/publish-backend-ghcr.yml"
    },
    "signatureVerification": {
      "mode": "sigstore-keyless-oidc",
      "oidcIssuer": "https://token.actions.githubusercontent.com",
      "certificateIdentity": "https://github.com/gihohoho/upgrade-rpg/.github/workflows/publish-backend-ghcr.yml@refs/heads/main",
      "subjectMustEqualPushedDigest": true
    },
    "automaticDeployment": false,
    "productionReferenceUpdate": false,
    "candidateDigestReleasedOnlyAfterAllGates": true
