      "cosign-keyless-sign-digest",
      "verify-cosign-identity-and-issuer",
      "emit-reviewed-candidate-digest"
    ],
    "signatureVerification": {
      "mode": "sigstore-keyless-oidc",
      "oidcIssuer": "https://token.actions.githubusercontent.com",
      "certificateIdentity": "https://github.com/gihohoho/upgrade-rpg/.github/workflows/publish-backend-ghcr.yml@refs/heads/main",
