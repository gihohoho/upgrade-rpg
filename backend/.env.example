APP_NAME="Idle RPG Backend"
ENVIRONMENT="local"
DEBUG=true
API_PREFIX="/api/v1"

# docker-compose.yml의 PostgreSQL 설정과 맞춰둔 로컬 개발용 DB 주소입니다.
DATABASE_URL="postgresql+asyncpg://rpg_user:rpg_password@localhost:5432/rpg_game"

# 운영 배포 전에는 반드시 강한 랜덤 문자열로 변경해야 합니다.
JWT_SECRET_KEY="change-me-before-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 현재 index.html 로컬 서버, 추후 Vite/Vue 개발 서버를 함께 허용합니다.
CORS_ORIGINS='["http://localhost:5500","http://127.0.0.1:5500","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]'
