APP_NAME="Idle RPG Backend"
ENVIRONMENT="local"
DEBUG=true
API_PREFIX="/api/v1"

# docker-compose.yml의 PostgreSQL 설정과 맞춰둔 로컬 개발용 DB 주소입니다.
DATABASE_URL="postgresql+asyncpg://rpg_user:rpg_password@127.0.0.1:55432/rpg_game"

# SQLAlchemy async connection pool 기본값입니다.
# 로컬에서는 아래 값을 그대로 사용해도 되며, 운영에서는 DB 허용 연결 수와
# backend worker 수를 함께 계산한 뒤 환경변수로 조정합니다.
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# 운영 배포 전에는 반드시 32자 이상의 강한 랜덤 문자열로 변경해야 합니다.
JWT_SECRET_KEY="change-me-before-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 로컬 개발용 관리자 쓰기 잠금 키입니다.
# 실제 운영 인증이 생기기 전까지 edit-apply / rollback-apply 같은 쓰기 API에만 사용합니다.
# 운영에서는 반드시 32자 이상의 별도 비밀값으로 변경해야 합니다.
ADMIN_WRITE_DEV_KEY="local-admin-dev-key"

# Render Free에서는 SMTP 포트가 차단되므로 계정 메일은 Brevo HTTPS API만 사용합니다.
# 실제 API key와 발신 주소는 Git에 넣지 말고 Render secret으로만 설정합니다.
EMAIL_PROVIDER="brevo"
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="Upgrade RPG"
EMAIL_TOKEN_SECRET="change-me-before-production-email-token"
# IP·이메일·token rate-limit key와 outbox 대상은 이 별도 HMAC key로만 저장합니다.
AUTH_ABUSE_SECRET="change-me-before-production-auth-abuse"
EMAIL_DELIVERY_TIMEOUT_SECONDS=10
PUBLIC_FRONTEND_ORIGIN="http://127.0.0.1:5500"
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
ACCOUNT_DELETION_EXPIRE_MINUTES=30
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_SECONDS=1
EMAIL_OUTBOX_MAINTENANCE_INTERVAL_SECONDS=300
EMAIL_OUTBOX_PREPARING_TIMEOUT_SECONDS=300
EMAIL_OUTBOX_SENDING_TIMEOUT_SECONDS=120
EMAIL_OUTBOX_RETENTION_DAYS=30

# FastAPI JSON 파싱 전에 raw body를 제한합니다. 인증 요청은 작은 별도 한도를 씁니다.
REQUEST_BODY_LIMIT_BYTES=2100000
AUTH_REQUEST_BODY_LIMIT_BYTES=16384

# 로컬은 proxy header를 신뢰하지 않습니다. Render 운영에서만 Cloudflare가 덮어쓰는
# CF-Connecting-IP를 읽도록 render로 설정합니다(X-Forwarded-For는 신뢰하지 않음).
AUTH_TRUSTED_PROXY_MODE="direct"
AUTH_DISCOVERY_RESPONSE_FLOOR_MS=350
AUTH_DISCOVERY_RESPONSE_JITTER_MS=100
AUTH_RATE_LIMIT_RETENTION_DAYS=30
UNVERIFIED_ACCOUNT_TTL_HOURS=168

# 최초 owner 관리자 1회 준비 전용입니다. FastAPI 시작 시 자동 실행되지 않습니다.
# 별도 script의 명시적 --apply와 정확한 확인 문구가 모두 있어야 동작합니다.
# 성공 직후 ENABLED를 false로 되돌리고 실제 .env의 PASSWORD 줄을 비우거나 제거합니다.
# 이 이메일은 자동 인증되지 않으며, 정상 이메일 링크 인증을 마쳐야 로그인할 수 있습니다.
OWNER_ADMIN_BOOTSTRAP_ENABLED=false
OWNER_ADMIN_USERNAME=""
OWNER_ADMIN_EMAIL=""
OWNER_ADMIN_PASSWORD=""

# 현재 index.html 로컬 서버, 추후 Vite/Vue 개발 서버를 함께 허용합니다.
CORS_ORIGINS='["http://localhost:5500","http://127.0.0.1:5500","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]'
