# syntax=docker/dockerfile:1.21.0@sha256:27f9262d43452075f3c410287a2c43f5ef1bf7ec2bb06e8c9eeb1b8d453087bc
FROM python:3.11.15-alpine3.23@sha256:ac0151f0eec4b7ba78bc47d337f328c6db706e7255b35b2327c2749f058c82fe AS builder

ENV PIP_NO_CACHE_DIR=1

COPY backend/requirements/pip-bootstrap.lock /tmp/requirements/pip-bootstrap.lock
COPY backend/requirements/runtime-musllinux-amd64-py311.lock /tmp/requirements/runtime.lock

RUN set -eux; \
    mkdir -p /tmp/pip-wheels /tmp/runtime-wheels /opt/python; \
    python -m pip download \
      --dest /tmp/pip-wheels \
      --require-hashes \
      --only-binary=:all: \
      --platform any \
      --python-version 3.11 \
      --implementation py \
      --abi none \
      -r /tmp/requirements/pip-bootstrap.lock; \
    python -m pip install \
      --no-index \
      --find-links=/tmp/pip-wheels \
      --require-hashes \
      --only-binary=:all: \
      -r /tmp/requirements/pip-bootstrap.lock; \
    python -m pip download \
      --dest /tmp/runtime-wheels \
      --require-hashes \
      --only-binary=:all: \
      --platform musllinux_1_2_x86_64 \
      --platform musllinux_1_1_x86_64 \
      --platform any \
      --python-version 3.11 \
      --implementation cp \
      --abi cp311 \
      --abi abi3 \
      --abi none \
      -r /tmp/requirements/runtime.lock; \
    python -m pip install \
      --no-index \
      --find-links=/tmp/runtime-wheels \
      --require-hashes \
      --only-binary=:all: \
      --no-compile \
      --target /opt/python \
      -r /tmp/requirements/runtime.lock; \
    rm -rf /tmp/pip-wheels /tmp/runtime-wheels /tmp/requirements

FROM python:3.11.15-alpine3.23@sha256:ac0151f0eec4b7ba78bc47d337f328c6db706e7255b35b2327c2749f058c82fe AS runtime

RUN set -eux; \
    rm -rf \
      /usr/local/bin/easy_install* \
      /usr/local/bin/pip* \
      /usr/local/lib/python3.11/ensurepip \
      /usr/local/lib/python3.11/site-packages/pip* \
      /usr/local/lib/python3.11/site-packages/setuptools* \
      /usr/local/lib/python3.11/site-packages/wheel*; \
    addgroup -g 65532 -S app; \
    adduser -u 65532 -S -D -H -G app app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/python

WORKDIR /app

COPY --from=builder --chown=65532:65532 /opt/python /opt/python
COPY --chown=65532:65532 backend/app /app/app
COPY --chown=65532:65532 backend/alembic.ini /app/alembic.ini
COPY --chown=65532:65532 backend/alembic /app/alembic

USER 65532:65532
EXPOSE 8000

# Migration은 서버 시작과 분리합니다. 이 command에는 Alembic을 묶지 않습니다.
ENTRYPOINT ["python3.11"]
CMD ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
